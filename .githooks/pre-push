#!/bin/sh
# Stops direct pushes to main. Go through a branch and a PR instead.
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Blocked: do not push straight to main. Push a branch and open a PR."
    echo "(Emergency only: git push --no-verify)"
    exit 1
  fi
done
