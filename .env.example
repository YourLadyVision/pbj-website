# Copy this file to .env.local and fill in the two values from Supabase (Project Settings > API).
# .env.local stays on your computer and is never uploaded.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The search assistant's "step out of the zone" (optional). The web address of a small service that takes
# { query, city } and returns { answer, items: [{ title, note, url }] }. Leave empty until that service exists:
# the assistant then says it is not connected and sends nothing.
VITE_ASSISTANT_URL=
